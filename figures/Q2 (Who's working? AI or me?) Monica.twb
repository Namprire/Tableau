    <worksheet name='Q2b'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true'>Which human-AI interaction modes account for this balance?</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='analysis_dataset' name='federated.13l7qh903kccq11a45fm51wtbpxi' />
          </datasources>
          <datasource-dependencies datasource='federated.13l7qh903kccq11a45fm51wtbpxi'>
            <column caption='Directive ' datatype='real' default-format='p0.0%' name='[Calculation_1533714508255236]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([directive_exposure_pct]) /&#10;(&#10;SUM([directive_exposure_pct]) +&#10;SUM([learning_exposure_pct]) +&#10;SUM([task_iteration_exposure_pct]) +&#10;SUM([feedback_loop_exposure_pct]) +&#10;SUM([validation_exposure_pct])&#10;)' />
            </column>
            <column caption='Learning  ' datatype='real' default-format='p0.0%' name='[Calculation_1533714508488709]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([learning_exposure_pct]) /&#10;(&#10;SUM([directive_exposure_pct]) +&#10;SUM([learning_exposure_pct]) +&#10;SUM([task_iteration_exposure_pct]) +&#10;SUM([feedback_loop_exposure_pct]) +&#10;SUM([validation_exposure_pct])&#10;)' />
            </column>
            <column caption='Iteration  ' datatype='real' default-format='p0.0%' name='[Calculation_1533714508701702]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([task_iteration_exposure_pct]) /&#10;(&#10;SUM([directive_exposure_pct]) +&#10;SUM([learning_exposure_pct]) +&#10;SUM([task_iteration_exposure_pct]) +&#10;SUM([feedback_loop_exposure_pct]) +&#10;SUM([validation_exposure_pct])&#10;)' />
            </column>
            <column caption='Feedback loop ' datatype='real' default-format='p0.0%' name='[Calculation_1533714508890119]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([feedback_loop_exposure_pct]) /&#10;(&#10;SUM([directive_exposure_pct]) +&#10;SUM([learning_exposure_pct]) +&#10;SUM([task_iteration_exposure_pct]) +&#10;SUM([feedback_loop_exposure_pct]) +&#10;SUM([validation_exposure_pct])&#10;)' />
            </column>
            <column caption='Validation  ' datatype='real' default-format='p0.0%' name='[Calculation_1533714509066248]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([validation_exposure_pct]) /&#10;(&#10;SUM([directive_exposure_pct]) +&#10;SUM([learning_exposure_pct]) +&#10;SUM([task_iteration_exposure_pct]) +&#10;SUM([feedback_loop_exposure_pct]) +&#10;SUM([validation_exposure_pct])&#10;)' />
